{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stt.example.com/schemas/homan-batch-manifest-v1.json",
  "title": "Homan native transcription batch manifest",
  "type": "object",
  "required": ["schema_version", "request_id", "items"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "options": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": ["id", "source", "start", "end", "file"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source": {
            "enum": ["microphone", "system", "legacy_mixed"]
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
