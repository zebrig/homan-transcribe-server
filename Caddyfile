{
	admin off
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$CADDY_SITE_ADDRESS} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	handle /healthz {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	handle /v1/audio/transcriptions {
		@unauthorized not header Authorization "Bearer {$TRANSCRIBE_API_KEY}"
		handle @unauthorized {
			header Content-Type application/json
			respond `{"error":{"message":"Unauthorized","type":"authentication_error"}}` 401
		}

		request_body {
			max_size 512MB
		}

		reverse_proxy whisper:8080
	}

	handle /v1/homan/audio/transcriptions {
		@unauthorized not header Authorization "Bearer {$TRANSCRIBE_API_KEY}"
		handle @unauthorized {
			header Content-Type application/json
			respond `{"error":{"message":"Unauthorized","type":"authentication_error"}}` 401
		}

		request_body {
			max_size 512MB
		}

		reverse_proxy whisper:8080
	}

	handle {
		header Content-Type application/json
		respond `{"error":{"message":"Not found","type":"invalid_request_error"}}` 404
	}
}
